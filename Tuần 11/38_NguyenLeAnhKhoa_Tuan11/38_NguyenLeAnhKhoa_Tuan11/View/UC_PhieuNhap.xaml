<UserControl x:Class="_38_NguyenLeAnhKhoa_Tuan11.View.UC_PhieuNhap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_38_NguyenLeAnhKhoa_Tuan11.View"
             mc:Ignorable="d" 
             d:DesignHeight="584" d:DesignWidth="700">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>
        <Border CornerRadius="20,20,20,20" BorderBrush="Black" BorderThickness="1" Margin="10,10,10,10" Padding="5,5,5,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <Label Content="Thông tin phiếu nhập" HorizontalAlignment="Left" VerticalAlignment="Top" FontWeight="Bold" FontSize="18"/>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Label Content="Ngày nhập"/>
                    <DatePicker/>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Label Content="Nhà cung cấp"/>
                    <ComboBox/>
                </StackPanel>
                <Border BorderThickness="1" Grid.Row="3" Background="#FFD8D8D8" CornerRadius="10,10,10,10">
                    <StackPanel>
                        <Label Content="Tổng tiền"/>
                        <Label Content="Số tiền" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>
                <Button Content="Tạo phiếu" Grid.Row="4" VerticalAlignment="Top" Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" Foreground="White" FontWeight="Bold" Margin="10,10,10,10"/>

            </Grid>
        </Border>
        <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1" CornerRadius="10,10,10,10" Margin="10,10,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Label Content="Chi tiết phiếu nhập" HorizontalAlignment="Left" VerticalAlignment="Top" FontWeight="Bold" FontSize="18"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ComboBox Width="125" Margin="15,0,15,0"/>
                    <TextBox TextWrapping="Wrap" Text="TextBox" Width="50" Margin="15,0,15,0"/>
                    <TextBox TextWrapping="Wrap" Text="TextBox" Width="50" Margin="15,0,15,0"/>
                    <Button Content="Button" Margin="15,0,15,0"/>
                </StackPanel>
                <DataGrid Grid.Row="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sản phẩm" Width="2*"/>
                        <DataGridTextColumn Header="Số lượng" Width="1*"/>
                        <DataGridTextColumn Header="Đơn giá" Width="1*"/>
                        <DataGridTextColumn Header="Thành tiền" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Lưu phiếu" Width="75" Margin="10,0,10,0"/>
                    <Button Content="Hủy" Width="75" Margin="10,0,10,0"/>
                </StackPanel>
            </Grid>
        </Border>


    </Grid>
</UserControl>
