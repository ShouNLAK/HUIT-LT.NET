<Window x:Class="_38_NguyenLeAnhKhoa_Tuan11.View.W_DangNhap"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_38_NguyenLeAnhKhoa_Tuan11.View"
        xmlns:vm="clr-namespace:_38_NguyenLeAnhKhoa_Tuan11.ViewModel"
        mc:Ignorable="d"
        Title="Đăng nhập hệ thống" Height="400" Width="420" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <!--<Window.DataContext>
        <vm:DangNhapViewModel/>
    </Window.DataContext>-->
    <Grid Background="#FFF4F4F4">
        <Border Background="White" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="10" Padding="25"
                HorizontalAlignment="Center" VerticalAlignment="Center" Width="330">
            <StackPanel>
                <TextBlock Text="ĐĂNG NHẬP HỆ THỐNG" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Tên đăng nhập" Margin="0,0,0,5"/>
                    <TextBox Height="28" Text="{Binding MaNV, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Mật khẩu" Margin="0,0,0,5"/>
                    <PasswordBox Height="28" PasswordChanged="PasswordBox_PasswordChanged"/>
                </StackPanel>

                <TextBlock Text="{Binding ThongBao}" Foreground="Red" FontWeight="Bold" TextWrapping="Wrap" Margin="0,5,0,10"/>

                <Button Content="Đăng nhập" Height="32" Width="120" HorizontalAlignment="Center"
                        Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" Foreground="White" FontWeight="Bold"
                        IsEnabled="{Binding IsInputValid}" Command="{Binding DangNhapCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Opacity" Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
