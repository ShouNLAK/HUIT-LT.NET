<Window x:Class="_38_NguyenLeAnhKhoa_Tuan11.View.W_DangNhap"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_38_NguyenLeAnhKhoa_Tuan11.View"
        xmlns:vm="clr-namespace:_38_NguyenLeAnhKhoa_Tuan11.ViewModel"
        mc:Ignorable="d"
            Title="Đăng nhập" Height="400" Width="400">
    <!--<Window.DataContext>
        <vm:DangNhapViewModel/>
    </Window.DataContext>-->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Label Content="Đăng nhập hệ thống" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" FontWeight="Bold"/>
        <StackPanel Margin="10,10,10,10" Grid.Row="1">
            <Label Content="Tên đăng nhập"/>
            <TextBox TextWrapping="Wrap" Margin="10,0,10,0" Text="{Binding MaNV,UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        
        <StackPanel Margin="10,10,10,10" Grid.Row="2">
            <Label Content="Mật khẩu"/>
            <TextBox TextWrapping="Wrap" Margin="10,0,10,0" Text="{Binding MatKhau,UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Margin="10,10,10,10" Grid.Row="3">
            <Label Content="{Binding ThongBao}" Height="34" Foreground="Red" FontWeight="Bold" VerticalAlignment="Center" Margin="0,5,0,5"/>
            <Button Content="Đăng nhập" HorizontalAlignment="Center" Grid.Row="3" VerticalAlignment="Center" Height="30" Width="70" Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" Foreground="White" FontWeight="Bold"
                IsEnabled="{Binding IsInputValid}" Command="{Binding DangNhapCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>
    </Grid>
</Window>
