<Window x:Class="_38_NguyenLeAnhKhoa_Tuan11.View.W_Form"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_38_NguyenLeAnhKhoa_Tuan11.View"
        xmlns:vm ="clr-namespace:_38_NguyenLeAnhKhoa_Tuan11.ViewModel"
        mc:Ignorable="d"
        Title="W_Form" Height="600" Width="1000">
    <Window.DataContext>
        <vm:FormViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>
        <Border BorderThickness="1" Background="#FFC7C7C7" Grid.RowSpan="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <Label Content="Hệ thống cửa hàng" FontWeight="Bold" FontSize="24" Grid.RowSpan="2"/>
                    <Label Content="{Binding TenNhanVien}" Grid.RowSpan="2"/>
                </StackPanel>

                <DockPanel Grid.Row="1" LastChildFill="True">
                    <Expander Header="Hệ thống" IsExpanded="True">
                        <StackPanel>
                            <Button Content="Đổi mật khẩu" Margin="0,5,0,5"/>
                            <Button Content="Sao lưu" Margin="0,5,0,5"/>
                            <Button Content="Phục hồi" Margin="0,5,0,5"/>
                            <Button Content="Đăng xuất" Margin="0,5,0,5" Command="{Binding DangXuatCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>
                    </Expander>
                </DockPanel>
                <DockPanel Grid.Row="2" LastChildFill="True">
                    <Expander Header="Danh mục" IsExpanded="True">
                        <StackPanel>
                            <Button Content="Loại sản phẩm" Margin="0,5,0,5"/>
                            <Button Content="Sản phẩm" Margin="0,5,0,5"/>
                            <Button Content="Nhà cung cấp" Margin="0,5,0,5"/>
                            <Button Content="Nhân viên" Margin="0,5,0,5"/>
                        </StackPanel>
                    </Expander>
                </DockPanel>
                <DockPanel Grid.Row="3" LastChildFill="True">
                    <Expander Header="Nhập hàng" IsExpanded="True">
                        <StackPanel>
                            <Button Content="Lập phiếu nhập" Margin="0,5,0,5"/>
                        </StackPanel>
                    </Expander>
                </DockPanel>
                <DockPanel Grid.Row="4" LastChildFill="True">
                    <Expander Header="Thống kê" IsExpanded="True">
                        <StackPanel>
                            <Button Content="Thống kê tồn kho" Margin="0,5,0,5"/>
                            <Button Content="Thống kê nhập" Margin="0,5,0,5"/>
                        </StackPanel>
                    </Expander>
                </DockPanel>


            </Grid>

        </Border>
        <ContentControl Grid.Column="1" Content="ContentControl" />

    </Grid>
</Window>
