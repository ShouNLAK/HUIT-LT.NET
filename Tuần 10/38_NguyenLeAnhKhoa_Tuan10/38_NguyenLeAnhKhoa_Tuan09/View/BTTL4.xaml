<Window x:Class="_38_NguyenLeAnhKhoa_Tuan09.View.BTTL4"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_38_NguyenLeAnhKhoa_Tuan09.View"
        xmlns:vm="clr-namespace:_38_NguyenLeAnhKhoa_Tuan09.ViewModel"
        mc:Ignorable="d"
        Title="BTTL4" Height="550" Width="900">
    <Window.DataContext>
        <vm:BTTL4_VM/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Border Margin="10,10,10,10" BorderBrush="#FF060606" BorderThickness="1" CornerRadius="20,20,20,20">
            <Grid Margin="10,10,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <Label Content="Thông tin sinh viên" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Grid.Row="1">
                    <Label Content="Mã sinh viên :"/>
                    <TextBox TextWrapping="Wrap" Text="{Binding MaSinhVien}" IsEnabled="{Binding IsMaSinhVienEnabled}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Grid.Row="2">
                    <Label Content="Họ tên :"/>
                    <TextBox TextWrapping="Wrap" Text="{Binding HoTen}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Grid.Row="3">
                    <Label Content="Giới tính :"/>
                    <ComboBox ItemsSource="{Binding List_GioiTinh}" SelectedItem="{Binding GioiTinh}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Grid.Row="4">
                    <Label Content="Ngày sinh :"/>
                    <DatePicker SelectedDate="{Binding NgaySinh}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Grid.Row="5">
                    <Label Content="Lớp :"/>
                    <ComboBox ItemsSource="{Binding DS_Lop}" 
                              DisplayMemberPath="MaLop" 
                              SelectedValuePath="MaLop" 
                              SelectedValue="{Binding MaLop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Thêm" Width="50" Margin="10,0,10,0" Command="{Binding AddCommand}" IsEnabled="{Binding IsAddEnabled}"/>
                    <Button Content="Sửa" Width="50" Margin="10,0,10,0" Command="{Binding UpdateCommand}" IsEnabled="{Binding IsUpdateEnabled}"/>
                    <Button Content="Xóa" Width="50" Margin="10,0,10,0" Command="{Binding DeleteCommand}" IsEnabled="{Binding IsDeleteEnabled}"/>
                    <Button Content="Lưu" Width="50" Margin="10,0,10,0" Command="{Binding SaveCommand}" IsEnabled="{Binding IsSaveEnabled}"/>
                    <Button Content="Hủy" Width="50" Margin="10,0,10,0" Command="{Binding CancelCommand}" IsEnabled="{Binding IsCancelEnabled}"/>
                </StackPanel>

            </Grid>
        </Border>
        <Border Grid.Column="1" Margin="10,10,10,10" BorderThickness="1" CornerRadius="20,20,20,20" BorderBrush="Black">
            <Grid Margin="10,10,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="9*"/>
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <Label Content="Danh sách sinh viên" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
                <DataGrid AutoGenerateColumns="False" Grid.Row="1" ItemsSource="{Binding DS_SinhVien}" SelectedItem="{Binding Selected_SinhVien}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã SV" Width="1*" Binding="{Binding MaSinhVien}"/>
                        <DataGridTextColumn Header="Họ tên" Width="1*" Binding="{Binding HoTen}"/>
                        <DataGridTextColumn Header="Giới tính" Width="1*" Binding="{Binding GioiTinh}"/>
                        <DataGridTextColumn Header="Ngày sinh" Width="1*" Binding="{Binding NgaySinh, StringFormat={}{0:dd/MM/yyyy}}"/>
                        <DataGridTextColumn Header="Mã lớp" Width="1*" Binding="{Binding MaLop}"/>
                    </DataGrid.Columns>
                </DataGrid>

            </Grid>
        </Border>
    </Grid>
</Window>
