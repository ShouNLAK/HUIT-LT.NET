<Window x:Class="_38_NguyenLeAnhKhoa_Tuan09.View.BTTL3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_38_NguyenLeAnhKhoa_Tuan09.View"
        xmlns:vm="clr-namespace:_38_NguyenLeAnhKhoa_Tuan09.ViewModel"
        mc:Ignorable="d"
        Title="BTTL3" Height="400" Width="800">
    <Window.DataContext>
        <vm:BTTL3_VM/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Border Margin="10,10,10,10" BorderBrush="#FF060606" BorderThickness="1" CornerRadius="20,20,20,20">
            <Grid Margin="10,10,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <Label Content="Thông tin lớp" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Grid.Row="1">
                    <Label Content="Mã lớp :"/>
                    <TextBox Text="{Binding MaLop, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsMaLopEnabled}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" VerticalAlignment="Center">
                    <Label Content="Mã khoa :"/>
                    <ComboBox ItemsSource="{Binding DS_Khoa}"
                              DisplayMemberPath="TenKhoa"
                              SelectedValuePath="MaKhoa"
                              SelectedValue="{Binding MaKhoa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Thêm" Width="50" Margin="10,0,10,0" Command="{Binding AddCommand}" IsEnabled="{Binding IsAddEnabled}"/>
                    <Button Content="Sửa" Width="50" Margin="10,0,10,0" Command="{Binding UpdateCommand}" IsEnabled="{Binding IsUpdateEnabled}"/>
                    <Button Content="Xóa" Width="50" Margin="10,0,10,0" Command="{Binding DeleteCommand}" IsEnabled="{Binding IsDeleteEnabled}"/>
                    <Button Content="Lưu" Width="50" Margin="10,0,10,0" Command="{Binding SaveCommand}" IsEnabled="{Binding IsSaveEnabled}"/>
                    <Button Content="Hủy" Width="50" Margin="10,0,10,0" Command="{Binding CancelCommand}" IsEnabled="{Binding IsCancelEnabled}"/>
                </StackPanel>

            </Grid>
        </Border>
        <Border Grid.Column="1" Margin="10,10,10,10" BorderThickness="1" CornerRadius="20,20,20,20" BorderBrush="Black">
            <Grid Margin="10,10,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="9*"/>
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <Label Content="Danh sách lớp" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
                <DataGrid AutoGenerateColumns="False" Grid.Row="1" ItemsSource="{Binding DS_Lop}" SelectedItem="{Binding Selected_Lop}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã lớp" Width="1*" Binding="{Binding MaLop}"/>
                        <DataGridTextColumn Header="Mã khoa" Width="1*" Binding="{Binding MaKhoa}"/>
                    </DataGrid.Columns>
                </DataGrid>

            </Grid>
        </Border>
    </Grid>
</Window>
