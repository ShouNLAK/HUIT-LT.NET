<Window x:Class="_38_NguyenLeAnhKhoa_Tuan09.View.BTTL1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_38_NguyenLeAnhKhoa_Tuan09.View"
        xmlns:vm="clr-namespace:_38_NguyenLeAnhKhoa_Tuan09.ViewModel"
        mc:Ignorable="d"
        Title="Quản lý khoa" Height="300" Width="600">
    <Window.DataContext>
        <vm:BTTL1_VM/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <GroupBox Header="Thông tin khoa : " Margin="10,10,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="5*"/>
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <Label Content="Mã khoa :"/>
                    <TextBox TextWrapping="Wrap" Text="{Binding MaKhoa}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <Label Content="Tên khoa :"/>
                    <TextBox TextWrapping="Wrap" Text="{Binding TenKhoa}"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Thêm" Width="50" Margin="10,0,10,0"/>
                    <Button Content="Sửa" Width="50" Margin="10,0,10,0"/>
                    <Button Content="Xóa" Width="50" Margin="10,0,10,0"/>
                </StackPanel>

            </Grid>
        </GroupBox>
        <GroupBox Grid.Column="1" Header="Danh sách khoa :" Margin="10,10,10,10">
            <Grid>
                <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding DS_Khoa}" SelectedItem="{Binding Selected_Khoa}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã khoa" Width="1*" Binding="{Binding MaKhoa}"/>
                        <DataGridTextColumn Header="Tên khoa" Width="2*" Binding="{Binding TenKhoa}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

    </Grid>
</Window>
