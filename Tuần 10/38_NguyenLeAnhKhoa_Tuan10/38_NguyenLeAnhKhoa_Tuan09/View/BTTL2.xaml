<Window x:Class="_38_NguyenLeAnhKhoa_Tuan09.View.BTTL2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_38_NguyenLeAnhKhoa_Tuan09.View"
        mc:Ignorable="d"
        Title="BTTL2" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu>
            <MenuItem Header="Hệ thống">
                <MenuItem Header="Sao lưu"/>
                <MenuItem Header="Phục hồi"/>
                <MenuItem Header="Đăng xuất"/>
                <MenuItem Header="Thoát"/>
            </MenuItem>
            <MenuItem Header="Danh mục">
                <MenuItem Header="Khoa" Click="MenuKhoa_Click"/>
                <MenuItem Header="Lớp"/>
                <MenuItem Header="Môn học"/>
                <MenuItem Header="Sinh viên"/>
            </MenuItem>
            <MenuItem Header="Quản lý điểm">
                <MenuItem Header="Xem điểm"/>
                <MenuItem Header="Nhập điểm">
                    <MenuItem Header="Theo sinh viên"/>
                    <MenuItem Header="Theo lớp"/>
                </MenuItem>
            </MenuItem>
        </Menu>

        <ContentControl x:Name="NoiDungChinh" Grid.Row="1"/>
    </Grid>
</Window>
