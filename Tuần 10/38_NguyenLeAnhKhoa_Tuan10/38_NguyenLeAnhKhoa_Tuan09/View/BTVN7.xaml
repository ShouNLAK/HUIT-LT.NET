<Window x:Class="_38_NguyenLeAnhKhoa_Tuan09.View.BTVN7"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_38_NguyenLeAnhKhoa_Tuan09.View"
        xmlns:vm="clr-namespace:_38_NguyenLeAnhKhoa_Tuan09.ViewModel"
        mc:Ignorable="d"
        Title="Xem điểm" Height="500" Width="900">
    <Window.DataContext>
        <vm:BTVN7_VM/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="BẢNG ĐIỂM SINH VIÊN" HorizontalAlignment="Center" Margin="0,10,0,10" FontSize="28" FontWeight="Bold" Foreground="Blue"/>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Margin="10" Padding="10" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Mã sinh viên:"/>
                <TextBox Grid.Column="1" Margin="5,0" VerticalAlignment="Center" Text="{Binding MaSinhVien, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="2" Content="Tìm" Width="80" Margin="10,0" Command="{Binding TimCommand}"/>
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="Họ tên:"/>
                <TextBox Grid.Column="4" Margin="5,0" VerticalAlignment="Center" IsReadOnly="True" Text="{Binding HoTen}"/>
                <TextBlock Grid.Column="5" VerticalAlignment="Center" Text="Lớp:"/>
                <TextBox Grid.Column="6" Margin="5,0" VerticalAlignment="Center" IsReadOnly="True" Text="{Binding MaLop}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Margin="10,0,10,10" Padding="10" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Năm học:"/>
                <ComboBox Grid.Column="1" Margin="5,0,15,0" ItemsSource="{Binding DS_NamHoc}" SelectedItem="{Binding Selected_NamHoc}"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="Học kỳ:"/>
                <ComboBox Grid.Column="3" Margin="5,0,15,0" ItemsSource="{Binding DS_HocKy}" SelectedItem="{Binding Selected_HocKy}"/>
                <Button Grid.Column="4" Content="Xem bảng điểm" Width="120" Command="{Binding XemBangDiemCommand}"/>
            </Grid>
        </Border>

        <DataGrid Grid.Row="3" Margin="10,0,10,10" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding DS_BangDiem}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="STT" Width="60" Binding="{Binding STT}"/>
                <DataGridTextColumn Header="Mã MH" Width="100" Binding="{Binding MaMH}"/>
                <DataGridTextColumn Header="Tên môn học" Width="*" Binding="{Binding TenMonHoc}"/>
                <DataGridTextColumn Header="Số TC" Width="100" Binding="{Binding SoTC}"/>
                <DataGridTextColumn Header="Điểm" Width="100" Binding="{Binding Diem}"/>
                <DataGridTextColumn Header="Điểm chữ" Width="100" Binding="{Binding DiemChu}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4" BorderBrush="Gray" BorderThickness="1" Margin="10,0,10,10" Padding="10" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" HorizontalAlignment="Center" FontWeight="Bold" Text="{Binding TongTinChi, StringFormat=Tổng tín chỉ: {0}}"/>
                <TextBlock Grid.Column="1" HorizontalAlignment="Center" FontWeight="Bold" Text="{Binding GPA, StringFormat=GPA: {0}}"/>
                <TextBlock Grid.Column="2" HorizontalAlignment="Center" FontWeight="Bold" Text="{Binding XepLoai, StringFormat=Xếp loại: {0}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
