<Window x:Class="_38_NguyenLeAnhKhoa_Tuan09.View.BTVN5"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_38_NguyenLeAnhKhoa_Tuan09.View"
        xmlns:vm="clr-namespace:_38_NguyenLeAnhKhoa_Tuan09.ViewModel"
        mc:Ignorable="d"
        Title="BTVN5" Height="650" Width="800">
    <Window.DataContext>
        <vm:BTVN5_VM/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Label Content="Quản lý môn học" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.ColumnSpan="2" FontSize="36" FontWeight="Bold"/>
            <DockPanel LastChildFill="True" Grid.Row="1" VerticalAlignment="Center" Margin="10,0,10,0">
                <Label Content="Mã môn :" Width="100"/>
                <TextBox TextWrapping="Wrap" Text="{Binding MaMonHoc}" IsEnabled="{Binding IsMaMonHocEnabled}"/>
            </DockPanel>
            <DockPanel LastChildFill="True" Grid.Row="2" VerticalAlignment="Center" Margin="10,0,10,0">
                <Label Content="Số tín chỉ : " Width="100"/>
                <TextBox TextWrapping="Wrap" Text="{Binding SoTinChi}"/>
            </DockPanel>
            <DockPanel LastChildFill="True" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0">
                <Label Content="Tên môn học :" Width="100"/>
                <TextBox TextWrapping="Wrap" Text="{Binding TenMonHoc}"/>
            </DockPanel>
            <DockPanel LastChildFill="True" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,10,0">
                <Label Content="Tính chất : " Width="100"/>
                <ComboBox ItemsSource="{Binding DS_TinhChat}" SelectedItem="{Binding TinhChat}"/>
            </DockPanel>
            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="Thêm" Width="50" Margin="10,0,10,0" Command="{Binding AddCommand}" IsEnabled="{Binding IsAddEnabled}"/>
                <Button Content="Sửa" Width="50" Margin="10,0,10,0" Command="{Binding UpdateCommand}" IsEnabled="{Binding IsUpdateEnabled}"/>
                <Button Content="Xóa" Width="50" Margin="10,0,10,0" Command="{Binding DeleteCommand}" IsEnabled="{Binding IsDeleteEnabled}"/>
                <Button Content="Lưu" Width="50" Margin="10,0,10,0" Command="{Binding SaveCommand}" IsEnabled="{Binding IsSaveEnabled}"/>
                <Button Content="Hủy" Width="50" Margin="10,0,10,0" Command="{Binding CancelCommand}" IsEnabled="{Binding IsCancelEnabled}"/>
            </StackPanel>
        </Grid>
        <DataGrid Grid.Row="1" ItemsSource="{Binding DS_MonHoc}" AutoGenerateColumns="False" SelectedItem="{Binding Selected_MonHoc}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã môn học" Width="1*" Binding="{Binding MaMonHoc}"/>
                <DataGridTextColumn Header="Tên môn học" Width="2*" Binding="{Binding TenMonHoc}"/>
                <DataGridTextColumn Header="Số tín chỉ" Width="1*" Binding="{Binding SoTC}"/>
                <DataGridTextColumn Header="Tính chất" Width="1*" Binding="{Binding TinhChat}"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>
