<Window x:Class="_18_NguyenLeAnhKhoa.View.Bai2_Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_18_NguyenLeAnhKhoa.View"
        xmlns:vm="clr-namespace:_18_NguyenLeAnhKhoa.ViewModel"
        mc:Ignorable="d"
        Title="Bai2_Main" Height="800" Width="800" Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" Closing="Window_Closing">
    
    <Window.DataContext>
        <vm:Bai2_ViewModel/>
    </Window.DataContext>
    
    <Border BorderBrush="Black" BorderThickness="1" CornerRadius="20,20,20,20" Margin="20,20,20,20" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <GroupBox Header="1. Thông tin khách hàng" Grid.Row="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="True" VerticalAlignment="Center">
                        <Label Content="Họ và tên khách hàng :" MinWidth="135"/>
                        <TextBox TextWrapping="Wrap" Text="{Binding HoTenKH, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <DockPanel LastChildFill="True" VerticalAlignment="Center" Grid.Column="1">
                        <Label Content="Số điện thoại :" MinWidth="135"/>
                        <TextBox TextWrapping="Wrap" Text="{Binding SoDienThoai, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <DockPanel LastChildFill="True" VerticalAlignment="Center" Grid.Row="1">
                        <Label Content="Địa chỉ :" MinWidth="135"/>
                        <TextBox TextWrapping="Wrap" Text="{Binding DiaChi, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <DockPanel LastChildFill="True" VerticalAlignment="Center" Grid.Column="1" Grid.Row="1">
                        <Label Content="Phòng :" MinWidth="135"/>
                        <TextBox TextWrapping="Wrap" Text="{Binding SoPhong, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                </Grid>
            </GroupBox>
            <GroupBox Header="2. Thông tin dịch vụ" Grid.Row="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.RowSpan="2">
                        <Label Content="Nhóm dịch vụ"/>
                        <ComboBox x:Name="cbo_NhomDV" ItemsSource="{Binding DS_NhomDV}" DisplayMemberPath="TenNhomDV" SelectedItem="{Binding Selected_NhomDichVu}" />
                    </StackPanel>
                    <StackPanel Grid.RowSpan="2" Grid.Column="1">
                        <Label Content="Dịch vụ"/>
                        <ListBox ItemsSource="{Binding DS_DichVu_Loc}" SelectedItem="{Binding Selected_DichVu}" DisplayMemberPath="TenDV" Height="117"/>
                    </StackPanel>
                    <StackPanel Grid.RowSpan="2" Grid.Column="2">
                        <Label Content="Số lần sử dụng : "/>
                        <TextBox TextWrapping="Wrap" Text="{Binding SoLanSuDung, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Thêm" HorizontalAlignment="Right" Width="50" Margin="0,20,20,0" Background="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" Foreground="White" FontWeight="Bold" Command="{Binding AddCommand}"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
            <GroupBox Header="3. Chi tiết phiếu dịch vụ" Grid.Row="3">
                <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding DSDV}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã DV" Width="1*" Binding="{Binding MaDV}"/>
                        <DataGridTextColumn Header="Tên dịch vụ" Width="2*" Binding="{Binding TenDV}"/>
                        <DataGridTextColumn Header="Số lần" Width="1*" Binding="{Binding SoLanSD}"/>
                        <DataGridTextColumn Header="Đơn giá" Width="2*" Binding="{Binding DonGia}"/>
                        <DataGridTextColumn Header="Thành tiền" Width="2*" Binding="{Binding ThanhTien}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <Label Content="Phiếu đăng ký dịch vụ khách sạn" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="36" FontWeight="Bold"/>
            <DockPanel LastChildFill="True" Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Label Content="Tổng tiền : "/>
                <TextBox TextWrapping="Wrap" Text="{Binding TongTien,Mode=OneWay}" Width="200" IsReadOnly="True"/>
            </DockPanel>
            <StackPanel Grid.Row="5" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Content="Lưu" Margin="20,0,20,0" Background="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" Foreground="White" FontWeight="Bold" Width="50" Command="{Binding ConfirmCommand}"/>
                <Button x:Name="btn_Exit" Content="Thoát" Width="50" Margin="20,0,20,0" Click="btn_Exit_Click"/>
            </StackPanel>
        </Grid>
    </Border>

</Window>
