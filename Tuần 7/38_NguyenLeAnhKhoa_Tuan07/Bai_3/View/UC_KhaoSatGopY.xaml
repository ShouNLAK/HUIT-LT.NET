<UserControl x:Class="_38_NguyenLeAnhKhoa_Tuan07.Bai_3.View.UC_KhaoSatGopY"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="980">
    <Grid Margin="6" Background="#FFE5E7EB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Khảo sát mức độ hài lòng"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#FF111827"
                   Margin="6,0,0,14" />

        <Border Grid.Row="1" Background="#FFF3F4F6" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Khách hàng" FontWeight="SemiBold" Foreground="#FF6B7280" />
                    <TextBox Height="40" Margin="0,6,0,0" IsReadOnly="True" Background="#FF2D8CF0" BorderBrush="#FF2D8CF0" Foreground="White" FontWeight="SemiBold" Padding="10,8" Text="{Binding TenKhachHang}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0">
                    <TextBlock Text="Số điện thoại" FontWeight="SemiBold" Foreground="#FF6B7280" />
                    <TextBox Height="40" Margin="0,6,0,0" IsReadOnly="True" Background="#FF2D8CF0" BorderBrush="#FF2D8CF0" Foreground="White" FontWeight="SemiBold" Padding="10,8" Text="{Binding SoDienThoai}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                    <TextBlock Text="Email" FontWeight="SemiBold" Foreground="#FF6B7280" />
                    <TextBox Height="40" Margin="0,6,0,0" IsReadOnly="True" Background="#FF2D8CF0" BorderBrush="#FF2D8CF0" Foreground="White" FontWeight="SemiBold" Padding="10,8" Text="{Binding Email}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#FFF3F4F6" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,12">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,10,0" Background="#FFF9FAFB">
                <Grid DataContext="{Binding CauHoiDangChon}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding TieuDeCauHoi}" FontWeight="Bold" FontSize="16" Foreground="#FF1F2937" />
                    <TextBlock Grid.Row="1" Text="{Binding NoiDungCauHoi}" TextWrapping="Wrap" Margin="0,8,0,14" FontSize="16" FontWeight="SemiBold" Foreground="#FF111827" />

                    <RadioButton Grid.Row="2" Content="Rất hài lòng" GroupName="{Binding TenNhomLuaChon}" IsChecked="{Binding ChonRatHaiLong}" FontSize="14" Margin="0,4" />
                    <RadioButton Grid.Row="3" Content="Hài lòng" GroupName="{Binding TenNhomLuaChon}" IsChecked="{Binding ChonHaiLong}" FontSize="14" Margin="0,4" />
                    <RadioButton Grid.Row="4" Content="Bình thường" GroupName="{Binding TenNhomLuaChon}" IsChecked="{Binding ChonBinhThuong}" FontSize="14" Margin="0,4" />
                    <RadioButton Grid.Row="5" Content="Không hài lòng" GroupName="{Binding TenNhomLuaChon}" IsChecked="{Binding ChonKhongHaiLong}" FontSize="14" Margin="0,4" VerticalAlignment="Top" />

                    <Border Grid.Row="6" BorderBrush="#FFE5E7EB" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
                        <TextBlock Text="{Binding ThongTinGoiY}" Foreground="#FF6B7280" FontSize="13" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="12" Padding="10" Background="#FFF9FAFB">
                <StackPanel>
                    <TextBlock Text="Danh sách phản hồi" FontSize="18" FontWeight="Bold" Foreground="#FF111827" Margin="0,0,0,10" />
                    <ListBox ItemsSource="{Binding DanhSachCauHoiTraLoi}" SelectedItem="{Binding CauHoiDangChon}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#FF22C55E" BorderThickness="1" Padding="8" Margin="0,0,0,8" Background="#FFF3F4F6">
                                    <TextBlock Text="{Binding HienThiTomTat}" TextWrapping="Wrap" FontSize="13" Foreground="#FF1F2937" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#FFF3F4F6" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="16" Padding="16">
            <StackPanel>
            <TextBlock Text="Góp ý thêm" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
            <TextBox Height="120"
                     Margin="0,6,0,0"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="14"
                     Text="{Binding GopYThem, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Gửi phản hồi"
                    Width="210"
                    Height="48"
                    Margin="0,0,10,0"
                    Background="#FF2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    FontSize="14"
                    Command="{Binding GuiPhanHoiCommand}" />

            <Button Content="Nhập lại"
                    Width="140"
                    Height="48"
                    Background="White"
                    Foreground="#FF1F2937"
                    BorderBrush="#FF9CA3AF"
                    BorderThickness="1"
                    FontWeight="SemiBold"
                    FontSize="14"
                    Command="{Binding NhapLaiCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
