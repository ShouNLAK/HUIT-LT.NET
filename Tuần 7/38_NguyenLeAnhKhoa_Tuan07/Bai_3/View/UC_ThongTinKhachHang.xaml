<UserControl x:Class="_38_NguyenLeAnhKhoa_Tuan07.Bai_3.View.UC_ThongTinKhachHang"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Thông tin khách hàng"
                   Grid.Row="0"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#FF1E293B"
                   Margin="0,0,0,18" />

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Tên khách hàng" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" />
            <TextBox Grid.Column="1" Height="36" FontSize="14" Padding="10,6" Text="{Binding TenKhachHang, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Số điện thoại" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" />
            <TextBox Grid.Column="1" Height="36" FontSize="14" Padding="10,6" Text="{Binding SoDienThoai, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Email" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" />
            <TextBox Grid.Column="1" Height="36" FontSize="14" Padding="10,6" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Content="Lưu thông tin"
                    Width="150"
                    Height="38"
                    Margin="0,0,10,0"
                    Background="#FF2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Command="{Binding LuuThongTinCommand}" />

            <Button Content="Nhập lại"
                    Width="120"
                    Height="38"
                    Background="#FF475569"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Command="{Binding NhapLaiCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
