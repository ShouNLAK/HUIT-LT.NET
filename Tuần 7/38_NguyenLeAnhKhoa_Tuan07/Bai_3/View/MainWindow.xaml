<Window x:Class="_38_NguyenLeAnhKhoa_Tuan07.Bai_3.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:_38_NguyenLeAnhKhoa_Tuan07.Bai_3.ViewModel"
        xmlns:view="clr-namespace:_38_NguyenLeAnhKhoa_Tuan07.Bai_3.View"
        mc:Ignorable="d"
        Title="Khảo Sát Khách Hàng" Height="780" Width="1280"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ThongTinKhachHangViewModel}">
            <view:UC_ThongTinKhachHang />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:KhaoSatGopYViewModel}">
            <view:UC_KhaoSatGopY />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DanhSachPhanHoiThongKeViewModel}">
            <view:UC_DanhSachPhanHoiThongKe />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#FFF5F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF0F172A" Padding="20,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Khảo sát và góp ý khách hàng" Foreground="White" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <Button Content="Phản hồi mới" DockPanel.Dock="Right" Width="150" Height="36" Margin="12,0,0,0" Background="#FF2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                        Command="{Binding ShowKhaoSatGopYCommand}" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="12" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Điều hướng" FontSize="17" FontWeight="Bold" Foreground="#FF1E293B" Margin="6,6,6,12" />

                    <Button Content="1. Thông tin khách hàng"
                            Height="44"
                            Margin="6,4"
                            Background="#FF2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Command="{Binding ShowThongTinKhachHangCommand}" />

                    <Button Content="2. Khảo sát và góp ý"
                            Height="44"
                            Margin="6,4"
                            Background="#FF0EA5E9"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Command="{Binding ShowKhaoSatGopYCommand}" />

                    <Button Content="3. Danh sách phản hồi"
                            Height="44"
                            Margin="6,4"
                            Background="#FF10B981"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Command="{Binding ShowDanhSachPhanHoiThongKeCommand}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="14">
                <ContentControl Content="{Binding CurrentViewModel}" />
            </Border>
        </Grid>
    </Grid>
</Window>
