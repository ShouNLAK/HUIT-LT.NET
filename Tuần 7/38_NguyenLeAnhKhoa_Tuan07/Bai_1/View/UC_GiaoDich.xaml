<UserControl x:Class="_38_NguyenLeAnhKhoa_Tuan07.Bai_1.View.UC_GiaoDich"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_38_NguyenLeAnhKhoa_Tuan07.Bai_1.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="Black" BorderThickness="1" CornerRadius="10,10,10,10" Margin="5,5,5,5" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="4*"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>
                <Label Content="Thực hiện giao dịch" HorizontalAlignment="Left" Margin="22,10,0,0" VerticalAlignment="Center" Grid.Row="0" FontSize="20" FontWeight="Bold"/>
                <Label Content="Loại giao dịch" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="1" Margin="10,0,0,0" FontWeight="Bold"/>
                <StackPanel Grid.Row="1" Margin="5,25,0,0" Orientation="Horizontal">
                    <RadioButton Content="Gửi tiền" Margin="10,0,10,0" GroupName="LoaiGD" IsChecked="{Binding IsGuiTien, Mode=TwoWay}"/>
                    <RadioButton Content="Rút tiền" Margin="10,0,10,0" GroupName="LoaiGD" IsChecked="{Binding IsRutTien, Mode=TwoWay}"/>
                    <RadioButton Content="Chuyển khoản" Margin="10,0,10,0" GroupName="LoaiGD" IsChecked="{Binding IsChuyenKhoan, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Label Content="Tài khoản nguồn" Margin="10,0,10,0"/>
                    <Border BorderBrush="Black" BorderThickness="1" CornerRadius="10,10,10,10" Margin="5,5,5,5" Background="#FF75C8DE" Height="60" Width="533">
                        <StackPanel VerticalAlignment="Center">
                            <ComboBox Width="520" ItemsSource="{Binding DSTK}" SelectedItem="{Binding TaiKhoanNguonGD}" DisplayMemberPath="HienThi"/>
                            <TextBlock TextWrapping="Wrap" Text="{Binding SoDuHienTai, StringFormat=Số dư hiện tại: {0}}" Margin="8,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="3">
                    <Label Content="Tài khoản đích" Margin="5,0,0,0"/>
                    <ComboBox Width="528" HorizontalAlignment="Center" ItemsSource="{Binding DSTK}" SelectedItem="{Binding TaiKhoanDichGD}" DisplayMemberPath="HienThi" IsEnabled="{Binding IsTaiKhoanDichEnabled}"/>
                </StackPanel>
                <StackPanel Grid.Row="4">
                    <Label Content="Số tiền giao dịch" Margin="5,0,0,0"/>
                    <TextBox TextWrapping="Wrap" Text="{Binding SoTienGD, UpdateSourceTrigger=PropertyChanged}" Width="528" Height="24"/>
                </StackPanel>
                <StackPanel Grid.Row="5">
                    <Label Content="Nội dung" Margin="5,0,0,0"/>
                    <TextBox TextWrapping="Wrap" Text="{Binding NoiDungGD, UpdateSourceTrigger=PropertyChanged}" Width="528" Height="24"/>
                </StackPanel>
                <Button Content="Xác nhận giao dịch" Margin="10,10,10,10" Grid.Row="6" Grid.RowSpan="2" Background="#FF0079FF" Foreground="White" FontWeight="Bold" Command="{Binding XacNhanGiaoDichCommand}"/>
            </Grid>
        </Border>
        <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1" CornerRadius="10,10,10,10" Margin="10,0,0,0" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="4*"/>
                </Grid.RowDefinitions>
                <Label Content="Tóm tắt" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="20" FontWeight="Bold"/>
                <Border Grid.Row="1" CornerRadius="10,10,10,10" Margin="10,10,10,10" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                    <StackPanel Margin="5,5,5,5">
                        <Label Content="Loại giao dịch"/>
                        <TextBlock TextWrapping="Wrap" Text="{Binding TomTatLoaiGiaoDich}"/>
                        <Label Content="Số tiền"/>
                        <TextBlock TextWrapping="Wrap" Text="{Binding TomTatSoTien}"/>
                        <Label Content="Phí giao dịch"/>
                        <TextBlock TextWrapping="Wrap" Text="{Binding PhiGiaoDich}"/>
                        <Border BorderBrush="Black" BorderThickness="1" Height="3" Background="Black"/>
                        <Label Content="Số dư sau giao dịch" FontWeight="Bold"/>
                        <TextBlock TextWrapping="Wrap" Text="{Binding SoDuSauGiaoDich}"/>

                    </StackPanel>
                </Border>
            </Grid>
        </Border>

    </Grid>
</UserControl>
