<UserControl x:Class="_38_NguyenLeAnhKhoa_Tuan07.Bai_1.View.UC_LichSu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_38_NguyenLeAnhKhoa_Tuan07.Bai_1.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>

        </Grid.RowDefinitions>
        <Border BorderBrush="Black" BorderThickness="1" CornerRadius="10,10,10,10" Background="White" Margin="5,5,5,5">
            <Label Content="Lịch sử giao dịch" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Margin="5,5,5,5"/>
        </Border>
        <Border BorderBrush="Black" BorderThickness="1" Grid.Row="1" CornerRadius="10,10,10,10" Background="White" Margin="5,5,5,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Label Content="Tài khoản"/>
                    <ComboBox Width="175" Height="30" ItemsSource="{Binding DSTK}" DisplayMemberPath="HienThi" SelectedItem="{Binding TaiKhoanLocLichSu}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <Label Content="Loại giao dịch"/>
                    <ComboBox Width="175" Height="30" ItemsSource="{Binding DSLoaiGiaoDichLoc}" SelectedItem="{Binding LoaiGiaoDichLoc}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Label Content="Từ khóa"/>
                    <TextBox Width="175" Height="30" Text="{Binding TuKhoaLichSu, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="Lọc" VerticalAlignment="Center" Margin="5,0,5,0" Width="60" Background="#FF1F75FF" Foreground="White" Command="{Binding LocLichSuCommand}"/>
                    <Button Content="Hiển thị tất cả" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,5,0" Command="{Binding HienThiTatCaCommand}"/>

                </StackPanel>
            </Grid>
        </Border>
        <Border BorderBrush="Black" BorderThickness="1" Grid.Row="2" CornerRadius="10,10,10,10" Background="White" Margin="5,5,5,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>
                <DataGrid Margin="5,5,5,5" ItemsSource="{Binding DSGDHienThi}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã GD" Width="1*" Binding="{Binding MaGD}"/>
                        <DataGridTextColumn Header="Ngày" Width="1*" Binding="{Binding NgayGD}"/>
                        <DataGridTextColumn Header="Loại" Width="1*" Binding="{Binding LoaiGD}"/>
                        <DataGridTextColumn Header="TK Nguồn" Width="1*" Binding="{Binding SoTKNguon}"/>
                        <DataGridTextColumn Header="TK Đích" Width="1*" Binding="{Binding SoTKDich}"/>
                        <DataGridTextColumn Header="Số tiền" Width="1*" Binding="{Binding SoTien}"/>
                        <DataGridTextColumn Header="Nội dung" Width="1*" Binding="{Binding NoiDung}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border BorderBrush="Black" BorderThickness="1" Grid.Row="1" CornerRadius="10,10,10,10" Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" Margin="5,5,5,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0">
                            <Label Content="Tổng thu" Margin="2,0,0,0" FontWeight="Bold"/>
                            <TextBlock TextWrapping="Wrap" Text="{Binding TongThuText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Label Content="Tổng chi" Margin="2,0,0,0" FontWeight="Bold"/>
                            <TextBlock TextWrapping="Wrap" Text="{Binding TongChiText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="Số giao dịch" Margin="2,0,0,0" FontWeight="Bold"/>
                            <TextBlock TextWrapping="Wrap" Text="{Binding SoGiaoDichText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
