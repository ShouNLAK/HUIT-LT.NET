<Window x:Class="_38_NguyenLeAnhKhoa_Tuan07.Bai_1.View.NganHangView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_38_NguyenLeAnhKhoa_Tuan07.Bai_1.View"
        xmlns:vm="clr-namespace:_38_NguyenLeAnhKhoa_Tuan07.Bai_1.ViewModel"
        mc:Ignorable="d"
        Title="Quản lý tài khoản ngân hàng" Height="550" Width="1200">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:TaiKhoanViewModel}">
            <local:UC_TaiKhoan/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GiaoDichViewModel}">
            <local:UC_GiaoDich/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LichSuViewModel}">
            <local:UC_LichSu/>
        </DataTemplate>
    </Window.Resources>
    
    <Grid Background="#FFE2E2E2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="Black" BorderThickness="1" Margin="10,10,7,10" CornerRadius="10,10,10,10" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="7*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Label Content="Ngân hàng mini" HorizontalAlignment="Center" VerticalAlignment="Center" Height="38" Width="201" FontWeight="Bold" FontSize="20"/>
                <StackPanel Grid.Row="1">
                    <Label Content="Chức năng" FontWeight="Bold" Margin="10,0,0,0"/>
                    <Button Content="Quản lý tài khoản" Margin="0,10,0,10" Width="190" Height="25" Command="{Binding navigation_TK}"/>
                    <Button Content="Giao dịch (Gửi/Rút/Chuyển)" Margin="0,0,0,10" Width="190" Height="25" Command="{Binding navigation_GD}"/>
                    <Button Content="Lịch sử giao dịch" Margin="0,0,0,10" Width="190" Height="25" Command="{Binding navigation_LS}"/>
                </StackPanel>
                <Border BorderBrush="Black" BorderThickness="1" Grid.Row="2" CornerRadius="10,10,10,10" Margin="10,3,10,3">
                    <Label Content="Gợi ý: Mỗi chức năng là UserControl. &#xD;&#xA;MainWindows chỉ có nhiệm vụ điều hướng" FontSize="9" HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
        <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1" Margin="10,10,10,10" CornerRadius="10,10,10,10" Background="White">
            <ContentControl Content="{Binding CurrentViewModel}"/>
        </Border>

    </Grid>
</Window>
