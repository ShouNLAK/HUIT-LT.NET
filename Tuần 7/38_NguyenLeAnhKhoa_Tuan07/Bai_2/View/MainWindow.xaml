<Window x:Class="_38_NguyenLeAnhKhoa_Tuan07.Bai_2.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_38_NguyenLeAnhKhoa_Tuan07.Bai_2.View"
        xmlns:vm="clr-namespace:_38_NguyenLeAnhKhoa_Tuan07.Bai_2.ViewModel"
        mc:Ignorable="d"
        Title="Cafe Sinh Viên - Quản lý bán hàng" Height="650" Width="1250">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LapHoaDonViewModel}">
            <local:UC_LapHoaDon/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DanhSachHoaDonViewModel}">
            <local:UC_DanhSachHoaDon/>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#FFEAEAEA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Margin="10" Background="White" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="120"/>
                </Grid.RowDefinitions>

                <Border Margin="12" Background="#FFF7F7F7" CornerRadius="8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                        <Ellipse Width="14" Height="14" Fill="#FF2D63E2" VerticalAlignment="Center"/>
                        <TextBlock Text="Cafe Sinh Viên" Margin="10,0,0,0" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Margin="10,8">
                    <Button Content="Lập hóa đơn" Height="38" Margin="0,0,0,8" Command="{Binding navigation_LapHoaDon}"/>
                    <Button Content="Danh sách hóa đơn" Height="38" Margin="0,0,0,8" Command="{Binding navigation_DanhSachHoaDon}"/>
                    <Button Content="Thống kê" Height="38" Margin="0,0,0,8" Command="{Binding navigation_ThongKe}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="10,12,10,10" VerticalAlignment="Bottom">
                    <Button Content="Thoát" Height="36" Background="#FF2D63E2" Foreground="White" Command="{Binding ThoatUngDungCommand}"/>
                    <TextBlock Text="© 2026 - WPF Lab 7" FontSize="11" Foreground="#FF808080" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Margin="0,10,10,10" Background="White" BorderBrush="#FFDDDDDD" BorderThickness="1" CornerRadius="10">
            <ContentControl Content="{Binding CurrentViewModel}" Margin="10"/>
        </Border>
    </Grid>
</Window>
