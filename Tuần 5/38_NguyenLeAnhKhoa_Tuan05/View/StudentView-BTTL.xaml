<Window x:Class="_38_NguyenLeAnhKhoa_Tuan05.View.StudentView_BTTL"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_38_NguyenLeAnhKhoa_Tuan05.View"
        xmlns:vm="clr-namespace:_38_NguyenLeAnhKhoa_Tuan05.ViewModel"
        mc:Ignorable="d"
        Title="Quản lý sinh viên" Height="450" Width="800">
    <Window.DataContext>
        <vm:StudentViewModel_BTTL/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>
        <Label Content="QUẢN LÝ SINH VIÊN" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Red" FontWeight="Bold" FontSize="36" Height="58" Width="356"/>
        <Border BorderBrush="Black" BorderThickness="1" Grid.Row="1" Margin="10,10,8,10" CornerRadius="10,10,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Họ và tên :" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" Height="25" Width="67"/>
                <Label Content="Giới tính :" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" Grid.Row="1" Height="25" Width="61"/>
                <TextBox TextWrapping="Wrap" Grid.Column="2" Margin="10,10,10,10" Width="270" Text="{Binding NewName,Mode=TwoWay}"/>
                <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <RadioButton x:Name="chk_Nam" Content="Nam" Margin="10,10,10,10" IsChecked="{Binding NewPhai,Mode=TwoWay}" />
                    <RadioButton x:Name="chk_Nu" Content="Nữ" Margin="10,10,10,10" IsChecked="{Binding NewNu,Mode=TwoWay}"/>
                </StackPanel>
                <Label Content="Tuổi :" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,10,10,10" Height="25" Width="80" Grid.Column="3"/>
                <Label Content="Thành phố :" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" Height="25" Width="80" Grid.Column="3" Grid.Row="1"/>
                <TextBox TextWrapping="Wrap" Grid.Column="4" Margin="10,10,10,10" Width="270" HorizontalAlignment="Center" Text="{Binding NewAge,Mode=TwoWay}"/>
                <ComboBox x:Name="cbo_City" Grid.Column="4" HorizontalAlignment="Center" Margin="10,10,10,10" Grid.Row="1" VerticalAlignment="Center" Width="270" Text="{Binding NewCity,Mode=TwoWay}"/>
                <StackPanel Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="10,10,10,10" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Button x:Name="btn_ThemSV" Content="Thêm" Margin="10,0,10,0" Width="50" Height="30" Background="#FF00FF04" Foreground="White" FontWeight="Bold" Click="btn_ThemSV_Click"/>
                    <Button x:Name="btn_XoaSV" Content="Xóa" Margin="10,0,10,0" Width="50" Height="30" Background="Red" Foreground="White" FontWeight="Bold" Click="btn_XoaSV_Click"/>
                    <Button x:Name="btn_Refresh" Content="Tải lại" Margin="10,0,10,0" Width="50" Height="30" Foreground="White" FontWeight="Bold" Background="#FFC3BABA" Click="btn_Refresh_Click"/>
                </StackPanel>

            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="484*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Tìm kiếm theo tên : " HorizontalAlignment="Left" Margin="10,10,10,10" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Width="250" Height="26" Margin="10,0,10,0" Text="{Binding SearchText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
            <Border BorderThickness="1" Grid.Column="2" CornerRadius="10,10,10,10" Background="#FFE2E2E2" Margin="10,10,10,10">
                <Label Content="{Binding Stat,StringFormat=Tổng số sinh viên: {0}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Background="{x:Null}" Foreground="#FF7F7F7F"/>
            </Border>
        </Grid>
        <DataGrid x:Name="dtg_dssv" Grid.Row="3" AutoGenerateColumns="False" ItemsSource="{Binding StudentsViewBTTL}" SelectedItem="{Binding SelectedStudent,Mode=TwoWay}" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Họ và tên" Width="5*" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Tuổi" Width="1*" Binding="{Binding Age}"/>
                <DataGridTextColumn Header="Giới tính" Width="1*" Binding="{Binding Gioitinh}"/>
                <DataGridTextColumn Header="Thành phố" Width="3*" Binding="{Binding Tp}"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>
