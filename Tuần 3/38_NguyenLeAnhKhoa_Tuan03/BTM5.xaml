<Window x:Class="_38_NguyenLeAnhKhoa_Tuan03.BTM5"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nộp hồ sơ ứng tuyển nhân viên" Height="550" Width="800" Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Thông tin cá nhân" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Mã hồ sơ:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox x:Name="txt_MaHS" Grid.Column="1" Height="25" Margin="0,0,0,8"/>

                <TextBlock Text="Họ tên:" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <TextBox x:Name="txt_HoTen" Grid.Row="1" Grid.Column="1" Height="25" Margin="0,0,0,8"/>

                <TextBlock Text="Giới tính:" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton x:Name="rbu_Nam" Content="Nam" IsChecked="True" Margin="0,0,20,0"/>
                    <RadioButton x:Name="rbu_Nu" Content="Nữ"/>
                </StackPanel>

                <TextBlock Text="Ngày sinh:" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <DatePicker x:Name="date_NgaySinh" Grid.Row="3" Grid.Column="1" Height="25" Margin="0,0,0,8"/>

                <TextBlock Text="Phòng ban:" Grid.Row="4" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <ComboBox x:Name="cbo_PhongBan" Grid.Row="4" Grid.Column="1" Height="25" Margin="0,0,0,8"/>
            </Grid>

            <TextBlock Text="Thông tin ứng tuyển" FontWeight="Bold" FontSize="14" Margin="0,10,0,10"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Vị trí:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                <ComboBox x:Name="cbo_ViTri" Grid.Column="1" Height="25" Margin="0,0,0,8"/>

                <TextBlock Text="Loại hợp đồng:" Grid.Row="1" VerticalAlignment="Top" Margin="0,0,10,8"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                    <RadioButton x:Name="rbu_ThoiVu" Content="Thời vụ" GroupName="HopDong" IsChecked="True"/>
                    <RadioButton x:Name="rbu_NienHan" Content="Hợp đồng niên" GroupName="HopDong"/>
                    <RadioButton x:Name="rbu_ChinhThuc" Content="Chính thức" GroupName="HopDong"/>
                </StackPanel>

                <TextBlock Text="Ghi chú:" Grid.Row="2" VerticalAlignment="Top" Margin="0,0,10,8"/>
                <TextBox x:Name="txt_GhiChu" Grid.Row="2" Grid.Column="1" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Hồ sơ và kỹ năng đính kèm" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

            <TextBlock Text="Giấy tờ bắt buộc" FontWeight="Bold" Margin="0,0,0,4"/>
            <WrapPanel Margin="0,0,0,10">
                <CheckBox x:Name="chk_SKhoe" Content="Giấy Khám sức khỏe" Margin="0,4,15,4"/>
                <CheckBox x:Name="chk_BangCap" Content="Bằng cấp" Margin="0,4,15,4"/>
                <CheckBox x:Name="chk_TinHoc" Content="Chứng chỉ Tin học" Margin="0,4,15,4"/>
                <CheckBox x:Name="chk_NgoaiNgu" Content="Chứng chỉ Ngoại ngữ" Margin="0,4,15,4"/>
            </WrapPanel>

            <TextBlock Text="Giấy tờ nộp kèm khác" FontWeight="Bold" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox x:Name="txt_GiayToKhac" Height="25" Width="280" Margin="0,0,10,0"/>
                <Button x:Name="btn_ThemGiayTo" Content="Thêm" Width="70" Height="25" Click="btn_ThemGiayTo_Click"/>
            </StackPanel>

            <TextBlock Text="Danh sách giấy tờ đã nộp" FontWeight="Bold" Margin="0,0,0,4"/>
            <ListBox x:Name="lst_GiayTo" Height="200" Margin="0,0,0,10"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button x:Name="btn_TaiLai" Content="Tải lại" Width="80" Margin="0,0,10,0" Background="#D91E1E" Foreground="White" Click="btn_TaiLai_Click"/>
            <Button x:Name="btn_Thoat" Content="Thoát" Width="80" Margin="0,0,10,0" Background="#7B3FE4" Foreground="White" Click="btn_Thoat_Click"/>
            <Button x:Name="btn_NopHS" Content="Nộp hồ sơ" Width="80" Background="#2B79FF" Foreground="White" Click="btn_NopHS_Click"/>
        </StackPanel>
    </Grid>
</Window>
