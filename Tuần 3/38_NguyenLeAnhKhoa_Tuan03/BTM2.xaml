<Window x:Class="_38_NguyenLeAnhKhoa_Tuan03.BTM2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ví dụ mẫu 2" Height="500" Width="500" Background="#FFD6D6D6" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Name="LabelFormat" TargetType="Label">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="10,10,0,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Width" Value="216"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TabControl x:Name="tabControl" HorizontalAlignment="Left" Height="383" Margin="10,10,0,0" VerticalAlignment="Top" Width="472" Grid.Row="1">
            <TabItem Header="Nhập thông tin cá nhân" Margin="0,0,-4,-2">
                <Grid Background="White" Margin="0,0,-6,-2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Họ và tên :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="26" Width="216" FontWeight="Bold"/>
                    <Label Content="Nghề nghiệp :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="26" Width="216" Grid.Column="1" FontWeight="Bold"/>
                    <TextBox x:Name="txt_Name" HorizontalAlignment="Left" Height="20" Margin="10,10,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="216"/>
                    <TextBox x:Name="txt_Job" HorizontalAlignment="Left" Height="20" Margin="10,10,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="216" Grid.Column="1"/>
                    <Label Content="Giới tính :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="26" Width="216" Grid.Row="2" FontWeight="Bold"/>
                    <StackPanel HorizontalAlignment="Center" Height="25" Margin="10,36,10,0" Grid.Row="2" VerticalAlignment="Top" Width="216" Orientation="Horizontal">
                        <RadioButton x:Name="rbu_Nam" Content="Nam" HorizontalAlignment="Center" Margin="40,0,20,0" VerticalAlignment="Top" IsChecked="True"/>
                        <RadioButton x:Name="rbu_Nu" Content="Nữ" HorizontalAlignment="Center" Margin="40,0,20,0" VerticalAlignment="Top"/>
                    </StackPanel>
                    <Label Content="Ngày sinh :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="26" Width="216" Grid.Row="3" FontWeight="Bold"/>
                    <DatePicker x:Name="date_Birth" HorizontalAlignment="Left" Margin="10,36,0,0" Grid.Row="3" VerticalAlignment="Top" Height="29" Width="216"/>
                    <Label Content="Sở thích :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="26" Width="216" Grid.Row="2" Grid.Column="1" FontWeight="Bold"/>
                    <StackPanel x:Name="stk_Hobby" Grid.Column="1" HorizontalAlignment="Left" Height="100" Margin="10,36,0,0" Grid.Row="2" VerticalAlignment="Top" Width="216" Grid.RowSpan="2">
                        <CheckBox x:Name="chk_Sach" Content="Đọc sách" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,10"/>
                        <CheckBox x:Name="chk_Nhac" Content="Nghe nhạc" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,10"/>
                        <CheckBox x:Name="chk_Sport" Content="Thể thao" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,10"/>
                        <CheckBox x:Name="chk_Travel" Content="Du lịch" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,10"/>
                    </StackPanel>
                    <Label Content="Quốc tịch :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="26" Width="216" Grid.Row="4" FontWeight="Bold"/>
                    <ComboBox x:Name="cbo_Nationality" HorizontalAlignment="Left" Margin="10,36,0,0" Grid.Row="4" VerticalAlignment="Top" Width="216" Height="21">
                        <ComboBoxItem Content="-- Chọn quốc tịch --" IsSelected="True"/>
                        <ComboBoxItem Content="Việt Nam"/>
                        <ComboBoxItem Content="Hoa Kỳ - Mỹ"/>
                        <ComboBoxItem Content="Indonesia"/>
                        <ComboBoxItem Content="Trung Quốc"/>
                    </ComboBox>
                    <Label Content="Kỹ năng :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="26" Width="216" Grid.Row="4" Grid.Column="1" FontWeight="Bold"/>
                    <ListBox x:Name="lst_Skill" Grid.Column="1" HorizontalAlignment="Left" Height="109" Margin="10,36,0,0" Grid.Row="4" VerticalAlignment="Top" Width="216" Grid.RowSpan="2" SelectionMode="Multiple">
                        <ListBoxItem Content="C# / .NET"/>
                        <ListBoxItem Content="WPF / XAML"/>
                        <ListBoxItem Content="SQL Server"/>
                        <ListBoxItem Content="HTML / CSS"/>
                        <ListBoxItem Content="Kỹ năng giao tiếp"/>
                        <ListBoxItem/>
                    </ListBox>
                </Grid>
            </TabItem>
            <TabItem Header="Xem thông tin đã nhập" Margin="0,0,-4,-2">
                <Grid Background="#FFE5E5E5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="235*"/>
                        <ColumnDefinition Width="231*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Họ và tên :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="26" Width="216" FontWeight="Bold"/>
                    <Label Content="Nghề nghiệp :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="26" Width="216" Grid.Column="1" FontWeight="Bold"/>
                    <Label Content="Giới tính :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="26" Width="216" Grid.Row="2" FontWeight="Bold"/>
                    <Label Content="Ngày sinh :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="26" Width="216" Grid.Row="3" FontWeight="Bold"/>
                    <Label Content="Sở thích :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="26" Width="216" Grid.Row="2" Grid.Column="1" FontWeight="Bold"/>
                    <Label Content="Quốc tịch :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="26" Width="216" Grid.Row="4" FontWeight="Bold"/>
                    <Label Content="Kỹ năng :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="26" Width="216" Grid.Row="3" Grid.Column="1" FontWeight="Bold"/>
                    <Label Content="Ghi chú :" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="26" Width="216" Grid.Row="4" Grid.Column="1" FontWeight="Bold"/>
                    <TextBlock x:Name="lbl_Ten" HorizontalAlignment="Left" Margin="10,36,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="216"/>
                    <TextBlock x:Name="lbl_Nghe" HorizontalAlignment="Left" Margin="10,36,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="216" Grid.Column="1"/>
                    <TextBlock x:Name="lbl_GT" HorizontalAlignment="Left" Margin="10,36,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="216" Grid.Row="2"/>
                    <TextBlock x:Name="lbl_soThich" HorizontalAlignment="Left" Margin="10,36,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="216" Grid.Row="2" Grid.Column="1"/>
                    <TextBlock x:Name="lbl_ngaySinh" HorizontalAlignment="Left" Margin="10,36,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="216" Grid.Row="3"/>
                    <TextBlock x:Name="lbl_kyNang" HorizontalAlignment="Left" Margin="10,36,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="216" Grid.Row="3" Grid.Column="1"/>
                    <TextBlock x:Name="lbl_quocTich" HorizontalAlignment="Left" Margin="10,36,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="216" Grid.Row="4"/>
                    <TextBlock x:Name="lbl_ghiChu" HorizontalAlignment="Left" Margin="10,36,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="216" Grid.Row="4" Grid.Column="1"/>
                </Grid>
            </TabItem>
        </TabControl>
        <Label Content="Thông tin - Sở thích cá nhân" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Margin="151,0,166,0" Width="175"/>
        <Button x:Name="btn_Data" Content="Xem thông tin" HorizontalAlignment="Left" Margin="145,408,0,0" Grid.Row="1" VerticalAlignment="Top" Width="88" Background="#FF0046FF" Foreground="White" Click="btn_Data_Click"/>
        <Button x:Name="btn_Exit" Content="Thoát" HorizontalAlignment="Left" Margin="266,408,0,0" Grid.Row="1" VerticalAlignment="Top" Width="88" Foreground="White" Background="Red" Click="btn_Exit_Click"/>

    </Grid>
</Window>
