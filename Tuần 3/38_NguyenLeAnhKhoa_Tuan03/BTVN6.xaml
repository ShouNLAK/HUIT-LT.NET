<Window x:Class="_38_NguyenLeAnhKhoa_Tuan03.BTVN6"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Khảo Sát Nhanh Ý Kiến Sinh Viên" Height="660" Width="900" Closing="Window_Closing">
    <Grid Margin="10">
        <TabControl x:Name="tabControl">
            <TabItem Header="Khảo sát">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Thông tin cá nhân" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Họ và tên:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                <TextBox x:Name="txt_HoTen" Grid.Column="1" Height="25" Margin="0,0,0,8"/>

                                <TextBlock Text="Lớp/Khoa:" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                <ComboBox x:Name="cbo_LopKhoa" Grid.Row="1" Grid.Column="1" Height="25" Margin="0,0,0,8"/>

                                <TextBlock Text="Giới tính:" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,10,8"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <RadioButton x:Name="rbu_Nam" Content="Nam" IsChecked="True" GroupName="GioiTinh" Margin="0,0,15,0"/>
                                    <RadioButton x:Name="rbu_Nu" Content="Nữ" GroupName="GioiTinh" Margin="0,0,15,0"/>
                                    <RadioButton x:Name="rbu_Khac" Content="Khác" GroupName="GioiTinh"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Ý kiến của bạn" FontWeight="Bold" FontSize="14" Margin="0,10,0,10"/>

                            <TextBlock Text="1. Đánh giá chất lượng giảng dạy môn học:" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="20,0,0,10">
                                <RadioButton x:Name="rbu_Rat_Tot" Content="Rất tốt" GroupName="CauHoi1" Margin="0,0,15,0"/>
                                <RadioButton x:Name="rbu_Tot" Content="Tốt" GroupName="CauHoi1" Margin="0,0,15,0"/>
                                <RadioButton x:Name="rbu_TrungBinh" Content="Trung bình" GroupName="CauHoi1" IsChecked="True" Margin="0,0,15,0"/>
                                <RadioButton x:Name="rbu_Kem" Content="Kém" GroupName="CauHoi1"/>
                            </StackPanel>

                            <TextBlock Text="2. Mức độ hài lòng với cơ sở vật chất:" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="20,0,0,10">
                                <RadioButton x:Name="rbu_RatHL" Content="Rất hài lòng" GroupName="CauHoi2" Margin="0,0,15,0"/>
                                <RadioButton x:Name="rbu_HaiLong" Content="Hài lòng" GroupName="CauHoi2" IsChecked="True" Margin="0,0,15,0"/>
                                <RadioButton x:Name="rbu_BinhThuong" Content="Bình thường" GroupName="CauHoi2" Margin="0,0,15,0"/>
                                <RadioButton x:Name="rbu_KhongHL" Content="Không hài lòng" GroupName="CauHoi2"/>
                            </StackPanel>

                            <TextBlock Text="3. Bạn muốn học online không?" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="20,0,0,10">
                                <RadioButton x:Name="rbu_Co" Content="Có" GroupName="CauHoi3" Margin="0,0,15,0"/>
                                <RadioButton x:Name="rbu_Khong" Content="Không" GroupName="CauHoi3" IsChecked="True" Margin="0,0,15,0"/>
                                <RadioButton x:Name="rbu_TuyTH" Content="Tùy trường hợp" GroupName="CauHoi3"/>
                            </StackPanel>

                            <TextBlock Text="Đề xuất cải thiện (chọn nhiều):" FontWeight="Bold" Margin="0,5,0,4"/>
                            <StackPanel Margin="20,0,0,10">
                                <CheckBox x:Name="chk_GiamHocPhi" Content="Giảm tải học phí" Margin="0,2"/>
                                <CheckBox x:Name="chk_TangTH" Content="Tăng thời lượng thực hành" Margin="0,2"/>
                                <CheckBox x:Name="chk_CaiThienCSVC" Content="Cải thiện cơ sở vật chất" Margin="0,2"/>
                                <CheckBox x:Name="chk_Wifi" Content="Cải thiện tốc độ Wifi" Margin="0,2"/>
                                <CheckBox x:Name="chk_GiangVien" Content="Giảng viên nhiệt tình hơn" Margin="0,2"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <CheckBox x:Name="chk_Khac" Content="Khác:" Margin="0,0,5,0"/>
                                    <TextBox x:Name="txt_DeXuatKhac" Width="200" Height="22"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Ý kiến đóng góp thêm:" FontWeight="Bold" Margin="0,5,0,4"/>
                            <TextBox x:Name="txt_YKien" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

                            <Button x:Name="btn_GuiKS" Content="Gửi khảo sát &amp; Xem lại" Width="180" HorizontalAlignment="Left" Click="btn_GuiKS_Click"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Kết quả của bạn">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="KẾT QUẢ KHẢO SÁT CỦA BẠN" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,10,0,10"/>

                    <TextBox x:Name="txt_KetQua" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" Background="#FFF5F5F5"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btn_LamMoi" Content="Làm khảo sát mới" Width="130" Margin="0,0,10,0" Click="btn_LamMoi_Click"/>
                        <Button x:Name="btn_Thoat" Content="Thoát" Width="80" Click="btn_Thoat_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
