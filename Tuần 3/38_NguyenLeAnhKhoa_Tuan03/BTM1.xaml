<Window x:Class="_38_NguyenLeAnhKhoa_Tuan03.BTM1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tuần 3 - Form Nâng Cao - BTM1" Height="250" Width="350"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="LabelFormat" TargetType="Label">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="10,10,0,0"/>
        </Style>
        <Style x:Key="TextboxFormat" TargetType="TextBox">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Height" Value="23"/>
            <Setter Property="Width" Value="250"/>
            <Setter Property="Margin" Value="0,13,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Content="Họ đệm :" Style="{StaticResource LabelFormat}" VerticalAlignment="Top"/>
        <Label Content="Tên :" Style="{StaticResource LabelFormat}" Grid.Row="1" VerticalAlignment="Top"/>
        <Label Content="Giới tính :" Style="{StaticResource LabelFormat}" Grid.Row="2" VerticalAlignment="Top"/>
        <Label Content="Ngoại ngữ :" Style="{StaticResource LabelFormat}" Grid.Row="3" VerticalAlignment="Top"/>
        <Label Content="Quê quán : " Style="{StaticResource LabelFormat}" Grid.Row="4" VerticalAlignment="Top"/>
        <TextBox x:Name="txt_Ho" Grid.Column="1" Style="{StaticResource TextboxFormat}"/>
        <TextBox x:Name="txt_Ten" Grid.Column="1" Style="{StaticResource TextboxFormat}" Grid.Row="1"/>
        <RadioButton x:Name="rbu_Nam" Content="Nam" Grid.Column="1" HorizontalAlignment="Left" Margin="10,16,0,0" Grid.Row="2" VerticalAlignment="Top" IsChecked="True"/>
        <RadioButton x:Name="rbu_Nu" Content="Nữ" Grid.Column="1" HorizontalAlignment="Left" Margin="115,16,0,0" Grid.Row="2" VerticalAlignment="Top"/>
        <CheckBox x:Name="chk_TAnh" Content="Tiếng Anh" Grid.Column="1" HorizontalAlignment="Left" Margin="10,16,0,0" Grid.Row="3" VerticalAlignment="Top"/>
        <CheckBox x:Name="chk_TTrung" Content="Tiếng Trung" Grid.Column="1" HorizontalAlignment="Left" Margin="115,16,0,0" Grid.Row="3" VerticalAlignment="Top"/>
        <ComboBox x:Name="Cbo_Que" Grid.Column="1" HorizontalAlignment="Left" Margin="4,14,0,0" Grid.Row="4" VerticalAlignment="Top" Width="240">
            <ComboBoxItem Content="TP.HCM"/>
            <ComboBoxItem Content="TP. Hà Nội"/>
            <ComboBoxItem Content="TP. Đà Nẵng"/>
            <ComboBoxItem Content="TP. Vinh"/>
            <ComboBoxItem Content="TP. Cần Thơ"/>
            <Label Content="Label"/>
        </ComboBox>
        <StackPanel HorizontalAlignment="Left" Height="69" Margin="12,10,0,0" Grid.Row="5" VerticalAlignment="Top" Width="240" Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="btn_XemTT" Content="Xem thông tin" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Margin="15,0,0,0" Click="btn_XemTT_Click"/>
            <Button x:Name="btn_Reset" Content="Nhập lại" HorizontalAlignment="Left" VerticalAlignment="Top" Width="90" Margin="15,0,0,0" Click="btn_Reset_Click"/>
        </StackPanel>

    </Grid>
</Window>
