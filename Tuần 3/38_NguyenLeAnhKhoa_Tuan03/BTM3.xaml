<Window x:Class="_38_NguyenLeAnhKhoa_Tuan03.BTM3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Form đặt bàn" Height="500" Width="700" Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Thông tin đặt món" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

            <TextBlock Text="Tên khách hàng:" Margin="0,0,0,4"/>
            <TextBox x:Name="txt_TenKH" Height="25" Margin="0,0,10,10"/>

            <TextBlock Text="Số điện thoại:" Margin="0,0,0,4"/>
            <TextBox x:Name="txt_SDT" Height="25" Margin="0,0,10,10"/>

            <TextBlock Text="Chọn bàn:" Margin="0,0,0,4"/>
            <ComboBox x:Name="cboBan" Height="25" Margin="0,0,10,10"/>

            <TextBlock Text="Chọn món ăn (có thể chọn nhiều món):" Margin="0,0,0,4"/>
            <ListBox x:Name="lstMon" Height="150" Margin="0,0,10,10" SelectionMode="Multiple"/>

            <Button x:Name="btn_XacNhan" Content="Xác nhận" Width="100" HorizontalAlignment="Left" Margin="0,5,0,0" Click="btn_XacNhan_Click"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Thông tin hiển thị" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

            <TextBlock Text="Thông tin khách hàng" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox x:Name="txt_ThongTinKH" Height="80" Margin="0,0,0,10" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="#FFE5E5E5"/>

            <TextBlock Text="Danh sách món đã chọn" FontWeight="Bold" Margin="0,0,0,4"/>
            <ListBox x:Name="lstMonDaChon" Height="150" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                <Button x:Name="btn_XoaMon" Content="Xóa món" Width="80" Margin="0,0,10,0" Click="btn_XoaMon_Click"/>
                <Button x:Name="btn_DatMon" Content="Đặt món" Width="80" Background="#2B79FF" Foreground="White" Click="btn_DatMon_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
