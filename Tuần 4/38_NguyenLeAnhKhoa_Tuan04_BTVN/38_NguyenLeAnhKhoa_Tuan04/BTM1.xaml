<Window x:Class="_38_NguyenLeAnhKhoa_Tuan04.BTM1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_38_NguyenLeAnhKhoa_Tuan04"
        mc:Ignorable="d"
        Title="Bài tập mẫu 1" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="65"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Menu Grid.RowSpan="2">
            <MenuItem Header="Hệ thống" FontWeight="Bold" Foreground="#FF0010FF">
                <MenuItem Header="Đăng nhập" FontWeight="Bold"/>
                <Separator/>
                <MenuItem Header="Thoát" InputGestureText="Alt + F4"/>
            </MenuItem>
            <MenuItem Header="Danh mục" FontWeight="Bold" Foreground="#FF0010FF">
                <MenuItem Header="Nhân viên" Click="MenuNV_Click"/>
                <MenuItem Header="Phòng ban" Click="MenuPB_Click"/>
            </MenuItem>
        </Menu>
        <ToolBarTray Margin="10,20,10,2">
            <ToolBar Margin="0,0,-611,-19">
                <Button Content="+ Thêm" Height="40" FontWeight="Bold"/>
                <Button Content="x Xóa" Margin="5,0,0,0" Height="40" FontWeight="Bold"/>
                <Separator Margin="5,0,0,0"/>
                <Button Content="- Thoát" Height="40" FontWeight="Bold"/>
            </ToolBar>
        </ToolBarTray>
        <ContentControl x:Name="MainContent" Grid.Row="1"/>
    </Grid>
</Window>
