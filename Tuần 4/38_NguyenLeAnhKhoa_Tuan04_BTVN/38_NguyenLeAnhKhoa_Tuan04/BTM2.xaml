<Window x:Class="_38_NguyenLeAnhKhoa_Tuan04.BTM2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_38_NguyenLeAnhKhoa_Tuan04"
        mc:Ignorable="d"
        Title="BTM2" Height="450" Width="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="231*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Content="Mã phòng" HorizontalAlignment="Left" Margin="10,0,0,0" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="txt_maPB" HorizontalAlignment="Left" Margin="10,0,0,0" Grid.Row="1" Grid.Column="0" TextWrapping="Wrap" VerticalAlignment="Center" Width="270" Height="40"/>
        <Label Content="Tên phòng ban" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0"/>
        <TextBox x:Name="txt_tenPB" HorizontalAlignment="Left" Margin="10,0,0,0" Grid.Row="3" Grid.Column="0" TextWrapping="Wrap" VerticalAlignment="Center" Width="270" Height="40"/>
        <Button x:Name="btn_ThemPB" Content="Thêm phòng ban" HorizontalAlignment="Center" Margin="10,10,10,10" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Width="240" Height="30" Click="btn_ThemPB_Click"/>
        <GroupBox Grid.Column="1" Header="Danh mục phòng ban" Margin="0,0,0,222" Grid.RowSpan="6">
            <TreeView x:Name="tvPhongBan" SelectedItemChanged="tvPhongBan_SelectedItemChanged">
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Xóa phòng ban" Click="Menu_XoaPB_Click"/>
                    </ContextMenu>
                </TreeView.ContextMenu>
            </TreeView>
        </GroupBox>
        <GroupBox Grid.Column="1" Header="Thông tin phòng ban đang chọn" Grid.Row="5" Margin="0,35,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="109*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Phòng ban :" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,10"/>
                <Label Content="Mã phòng :" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,10,0,10" Grid.Row="1"/>
                <Button Grid.Column="1" Content="Thoát" HorizontalAlignment="Right" Grid.Row="2" VerticalAlignment="Top" Width="50"/>
                <TextBlock x:Name="lblTenPB" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" Margin="5,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Width="209" Height="25" Background="#FFFFF500"/>
                <TextBlock x:Name="lblMaPB" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" Margin="5,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Width="209" Height="25" Background="#FFFFF500"/>
            </Grid>
        </GroupBox>
    </Grid>

</Window>
