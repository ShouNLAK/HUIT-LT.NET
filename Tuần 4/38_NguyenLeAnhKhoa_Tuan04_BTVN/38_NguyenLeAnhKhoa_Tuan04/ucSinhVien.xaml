<UserControl x:Class="_38_NguyenLeAnhKhoa_Tuan04.ucSinhVien"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_38_NguyenLeAnhKhoa_Tuan04"
             mc:Ignorable="d" 
             d:DesignHeight="370" d:DesignWidth="550">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <GroupBox Header="Thông tin sinh viên" Grid.Row="1" Grid.RowSpan="7" Grid.ColumnSpan="2"/>
        <Label Content="Mã sinh viên :" HorizontalAlignment="Center" Width="140" Grid.Row="1" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Height="30"/>
        <Label Content="Họ và tên :" HorizontalAlignment="Center" Width="140" Grid.Row="2" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Height="30"/>
        <Label Content="Ngày sinh :" HorizontalAlignment="Center" Width="140" Grid.Row="3" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Height="30"/>
        <Label Content="Giới tính :" HorizontalAlignment="Center" Width="140" Grid.Row="4" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Height="30"/>
        <Label Content="Sở thích :" HorizontalAlignment="Center" Width="140" Grid.Row="5" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Height="30"/>
        <Label Content="Lớp học :" HorizontalAlignment="Center" Width="140" Grid.Row="6" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Height="30"/>
        <TextBox x:Name="txt_MSSV" Grid.Column="1" HorizontalAlignment="Center" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="370" Grid.Row="1" Height="38"/>
        <TextBox x:Name="txt_TenSV" Grid.Column="1" HorizontalAlignment="Center" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="370" Grid.Row="2" Height="38"/>
        <DatePicker x:Name="txt_Date" Grid.Column="1" HorizontalAlignment="Center" Text="" VerticalAlignment="Center" Width="370" Grid.Row="3" Height="38"/>
        <Button Grid.Column="1" Content="Button" HorizontalAlignment="Left" Margin="722,0,0,0" Grid.Row="2" VerticalAlignment="Center" Width="0" Height="20"/>
        <WrapPanel Grid.Row="7" HorizontalAlignment="Right" Grid.Column="1" Margin="0,0,10,0">
            <Button x:Name="btn_Luu" Content="Lưu" HorizontalAlignment="Left" VerticalAlignment="Top" Width="80" Click="btn_Luu_Click"/>
            <Button x:Name="btn_Xoa" Content="Xóa" HorizontalAlignment="Left" VerticalAlignment="Top" Width="80" Margin="10,0,0,0" Click="btn_Xoa_Click"/>
            <Button x:Name="btn_LamMoi" Content="Làm mới" HorizontalAlignment="Left" VerticalAlignment="Top" Width="80" Margin="10,0,0,0" Click="btn_LamMoi_Click"/>
        </WrapPanel>
        <StackPanel Grid.Column="1" Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <RadioButton x:Name="btn_Nam" Content="Nam" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,20,0" IsChecked="False" Checked="btn_Nam_Checked"/>
            <RadioButton x:Name="btn_Nu" Content="Nữ" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,20,0" IsChecked="False" Checked="btn_Nu_Checked"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <CheckBox x:Name="chk_Sport" Content="Thể thao" Margin="20,0,40,0"/>
            <CheckBox x:Name="chk_Music" Content="Âm nhạc" Margin="20,0,40,0"/>
            <CheckBox x:Name="chk_Travel" Content="Du lịch" Margin="20,0,40,0"/>
        </StackPanel>
        <ComboBox x:Name="cbo_Lop" Grid.Column="1" HorizontalAlignment="Left" Margin="10,0,0,0" Grid.Row="6" Width="370" Height="38"/>
    </Grid>
</UserControl>
