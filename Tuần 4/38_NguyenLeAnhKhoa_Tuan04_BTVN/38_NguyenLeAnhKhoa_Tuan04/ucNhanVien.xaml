<UserControl x:Class="_38_NguyenLeAnhKhoa_Tuan04.ucNhanVien"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="550">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="HỒ SƠ NHÂN VIÊN" Grid.ColumnSpan="2" FontWeight="Bold" FontSize="14" HorizontalAlignment="Left" Margin="0,0,0,15"/>

        <Label Content="Mã số" Grid.Row="1" VerticalAlignment="Center"/>
        <TextBox x:Name="txtMaSo" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Height="25"/>

        <Label Content="Họ tên" Grid.Row="2" VerticalAlignment="Center"/>
        <TextBox x:Name="txtHoTen" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Height="25"/>

        <Label Content="Địa chỉ" Grid.Row="3" VerticalAlignment="Center"/>
        <TextBox x:Name="txtDiaChi" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Height="25"/>

        <Label Content="Điện thoại" Grid.Row="4" VerticalAlignment="Center"/>
        <TextBox x:Name="txtDienThoai" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Height="25"/>

        <Label Content="Phòng ban" Grid.Row="5" VerticalAlignment="Center"/>
        <TextBox x:Name="txtPhongBan" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Height="25" IsReadOnly="True" Background="#EEEEEE"/>

        <WrapPanel Grid.Row="6" Grid.Column="1" Margin="0,20,0,0" HorizontalAlignment="Left">
            <Button x:Name="btnThem" Content="Thêm" Width="70" Height="25" Margin="0,0,10,0" Click="btnThem_Click"/>
            <Button x:Name="btnSua" Content="Sửa" Width="70" Height="25" Margin="0,0,10,0" Click="btnSua_Click"/>
            <Button x:Name="btnXoa" Content="Xóa" Width="70" Height="25" Margin="0,0,10,0" Click="btnXoa_Click"/>
            <Button x:Name="btnLamMoi" Content="Làm mới" Width="70" Height="25" Margin="0,0,10,0" Click="btnLamMoi_Click"/>
        </WrapPanel>
    </Grid>
</UserControl>
