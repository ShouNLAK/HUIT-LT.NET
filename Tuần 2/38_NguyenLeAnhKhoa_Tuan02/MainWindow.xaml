        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tuần 2 - WPF Control Nâng Cao và Style" Height="350" Width="525">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Bài thực hành tuần 2: Control nâng cao, Style và ResourceDictionary"
                   Margin="20,20,20,10"
                   TextWrapping="Wrap"
                   FontWeight="Bold"
                   Foreground="#FF1E3A8A"/>

        <StackPanel Grid.Row="1" Margin="20,10,20,20">
            <Button Content="Mở BTM1" Height="32" Margin="0,0,0,8"/>
            <Button Content="Mở BTM2" Height="32" Margin="0,0,0,8"/>
            <Button Content="Mở BTM3" Height="32" Margin="0,0,0,8"/>
            <Button Content="Mở BTM4" Height="32"/>
        </StackPanel>
    </Grid>
</Window>
