<Window x:Class="NguyenLeAnhKhoa_2001240206_KT2.View.Window_DatPhong"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NguyenLeAnhKhoa_2001240206_KT2.ViewModel"
        mc:Ignorable="d"
        Title="Window1" Height="520" Width="720" WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:BookingViewModel/>
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- === CỘT TRÁI: Thông tin đặt phòng === -->
        <GroupBox Header="Thông tin đặt phòng" Margin="0,0,5,0">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Ngày đặt phòng:" VerticalAlignment="Center" Margin="0,4"/>
                <DatePicker Grid.Column="1" Margin="4"
                            SelectedDate="{Binding NgayDatPhong}"/>

                <TextBlock Grid.Row="1" Text="Chọn phòng:" VerticalAlignment="Center" Margin="0,4"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="4"
                          ItemsSource="{Binding DanhSachPhong}"
                          DisplayMemberPath="TenPhong"
                          SelectedItem="{Binding SelectedPhong}"/>

                <TextBlock Grid.Row="2" Text="Giá phòng:" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox Grid.Row="2" Grid.Column="1" Margin="4" IsReadOnly="True"
                         Text="{Binding GiaPhong}"/>

                <TextBlock Grid.Row="3" Text="Sức chứa:" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox Grid.Row="3" Grid.Column="1" Margin="4" IsReadOnly="True"
                         Text="{Binding SucChua}"/>

                <TextBlock Grid.Row="4" Text="Chọn khách hàng:" VerticalAlignment="Center" Margin="0,4"/>
                <ComboBox Grid.Row="4" Grid.Column="1" Margin="4"
                          ItemsSource="{Binding DanhSachKhachHang}"
                          DisplayMemberPath="TenKH"
                          SelectedItem="{Binding SelectedKhachHang}"/>

                <TextBlock Grid.Row="5" Text="Giờ vào:" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox Grid.Row="5" Grid.Column="1" Margin="4"
                         Text="{Binding GioVao, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="6" Text="Giờ ra:" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox Grid.Row="6" Grid.Column="1" Margin="4"
                         Text="{Binding GioRa, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </GroupBox>

        <!-- === CỘT PHẢI: Thông tin phụ thu === -->
        <Grid Grid.Column="1" Margin="5,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Chọn phụ thu -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Chọn phụ thu:" VerticalAlignment="Center" Margin="0,4"/>
                <ComboBox Grid.Column="1" Margin="4"
                          ItemsSource="{Binding DanhSachPhuThu}"
                          DisplayMemberPath="TenPhuThu"
                          SelectedItem="{Binding SelectedPhuThu}"/>
                <TextBlock Grid.Column="2" Text="Giá:" VerticalAlignment="Center" Margin="4,4,0,4"/>
                <TextBox Grid.Column="3" Margin="4" IsReadOnly="True"
                         Text="{Binding GiaPhuThu}"/>
                <Button Grid.Column="4" Content="Thêm" Margin="4"
                        Command="{Binding ThemPhuThuCommand}"/>
            </Grid>

            <!-- Số lượng -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Số lượng:" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox Grid.Column="1" Margin="4"
                         Text="{Binding SoLuongPhuThu, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <!-- Danh sách chi tiết phụ thu -->
            <DataGrid Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                      ItemsSource="{Binding DanhSachChiTiet}" Margin="0,4">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã phụ thu"  Binding="{Binding MaPhuThu}"  Width="90"/>
                    <DataGridTextColumn Header="Tên phụ thu" Binding="{Binding TenPhuThu}" Width="*"/>
                    <DataGridTextColumn Header="Giá phụ thu" Binding="{Binding GiaPhuThu}" Width="90"/>
                    <DataGridTextColumn Header="Số lượng"    Binding="{Binding SoLuong}"   Width="70"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Tổng tiền tạm tính -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4">
                <TextBlock Text="Tổng tiền tạm tính" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Width="120" IsReadOnly="True" Text="{Binding TongTienTamTinh, StringFormat=N0}"/>
            </StackPanel>

            <!-- Nút Đặt phòng -->
            <Button Grid.Row="4" Content="Đặt phòng" HorizontalAlignment="Right"
                    Width="90" Height="30" Margin="0,4"
                    Command="{Binding DatPhongCommand}"/>
        </Grid>
    </Grid>
</Window>
