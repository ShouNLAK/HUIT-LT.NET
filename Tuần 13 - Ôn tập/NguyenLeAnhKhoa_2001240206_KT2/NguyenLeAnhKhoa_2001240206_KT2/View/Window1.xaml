<Window x:Class="NguyenLeAnhKhoa_2001240206_KT2.View.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NguyenLeAnhKhoa_2001240206_KT2.View"
        xmlns:vm="clr-namespace:NguyenLeAnhKhoa_2001240206_KT2.ViewModel"
        mc:Ignorable="d"
        Title="MainWindow" Height="580" Width="820" WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:RoomViewModel/>
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Thông tin phòng" FontWeight="Bold" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0 -->
                <TextBlock Text="Chọn tầng nhà:" VerticalAlignment="Center" Margin="5"/>
                <ComboBox Grid.Column="1" Margin="5"
                          ItemsSource="{Binding DanhSachTang}"
                          DisplayMemberPath="TenNhom"
                          SelectedItem="{Binding SelectedFloor}"/>

                <TextBlock Grid.Column="2" Text="Mã phòng:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Column="3" Margin="5" Text="{Binding MaPhong, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Row 1 -->
                <TextBlock Grid.Row="1" Text="Tên phòng:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="5"
                         Text="{Binding TenPhong, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Row 2 -->
                <TextBlock Grid.Row="2" Text="Giá phòng:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="2" Grid.Column="1" Margin="5"
                         Text="{Binding GiaPhong, UpdateSourceTrigger=PropertyChanged}"/>

                <GroupBox Grid.Row="2" Grid.RowSpan="2" Grid.Column="2" Grid.ColumnSpan="2" Header="Loại phòng" Margin="5">
                    <StackPanel>
                        <RadioButton Content="Phòng quạt" Margin="5" IsChecked="{Binding IsFanRoom}"/>
                        <RadioButton Content="Phòng máy lạnh" Margin="5" IsChecked="{Binding IsACRoom}"/>
                    </StackPanel>
                </GroupBox>

                <!-- Row 3 -->
                <TextBlock Grid.Row="3" Text="Sức chứa tối đa:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="3" Grid.Column="1" Margin="5"
                         Text="{Binding SucChua, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button Content="Thêm" Width="80" Height="30" Margin="10,0" Command="{Binding AddCommand}"/>
            <Button Content="Xóa"  Width="80" Height="30" Margin="10,0" Command="{Binding DeleteCommand}"/>
            <Button Content="Sửa"  Width="80" Height="30" Margin="10,0" Command="{Binding EditCommand}"/>
            <Button Content="Lưu"  Width="80" Height="30" Margin="10,0" Command="{Binding SaveCommand}"/>
        </StackPanel>

        <DataGrid Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  ItemsSource="{Binding DanhSachPhong}"
                  SelectedItem="{Binding SelectedRoom}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã phòng"  Binding="{Binding MaPhong}"          Width="90"/>
                <DataGridTextColumn Header="Tên phòng" Binding="{Binding TenPhong}"          Width="*"/>
                <DataGridTextColumn Header="Sức chứa"  Binding="{Binding SucChua}"           Width="80"/>
                <DataGridTextColumn Header="Giá phòng" Binding="{Binding GiaPhong}"          Width="100"/>
                <DataGridTextColumn Header="Tên tầng"  Binding="{Binding LOAIPHONG.TenNhom}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
