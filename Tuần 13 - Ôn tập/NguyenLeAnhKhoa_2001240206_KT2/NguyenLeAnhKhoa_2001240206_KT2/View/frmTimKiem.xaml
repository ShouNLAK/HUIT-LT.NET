<Window x:Class="NguyenLeAnhKhoa_2001240206_KT2.View.frmTimKiem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NguyenLeAnhKhoa_2001240206_KT2.ViewModel"
        mc:Ignorable="d"
        Title="frmTimKiem" Height="420" Width="640" WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:SearchViewModel/>
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Cột trái: Điều kiện tìm kiếm -->
        <StackPanel Margin="5">
            <TextBlock Text="Chọn tầng" Margin="0,5,0,2"/>
            <ComboBox ItemsSource="{Binding DanhSachTang}"
                      DisplayMemberPath="TenNhom"
                      SelectedItem="{Binding SelectedFloor}"
                      Margin="0,0,0,8"/>

            <TextBlock Text="Sức chứa" Margin="0,5,0,2"/>
            <TextBox Text="{Binding SucChua, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

            <Button Content="Tìm kiếm" Width="80" HorizontalAlignment="Left"
                    Command="{Binding TimKiemCommand}" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Cột phải: Kết quả tìm kiếm + thông tin chi tiết -->
        <Grid Grid.Column="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ListBox kết quả -->
            <ListBox ItemsSource="{Binding KetQuaTimKiem}"
                     DisplayMemberPath="MaPhong"
                     SelectedItem="{Binding SelectedPhong}"
                     Margin="0,0,5,0"/>

            <!-- Thông tin chi tiết phòng -->
            <GroupBox Grid.Column="1" Header="Thông tin phòng" Margin="0">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Tên phòng" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Column="1" Margin="4" IsReadOnly="True"
                             Text="{Binding TenPhong}"/>

                    <TextBlock Grid.Row="1" Text="Sức chứa" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="4" IsReadOnly="True"
                             Text="{Binding SucChuaHienThi}"/>

                    <TextBlock Grid.Row="2" Text="Giá" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="4" IsReadOnly="True"
                             Text="{Binding GiaPhong}"/>

                    <TextBlock Grid.Row="3" Text="Kiểu phòng" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="4" IsReadOnly="True"
                             Text="{Binding KieuPhong}"/>

                    <TextBlock Grid.Row="4" Text="Tình trạng" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="4" IsReadOnly="True"
                             Text="{Binding TinhTrang}"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
