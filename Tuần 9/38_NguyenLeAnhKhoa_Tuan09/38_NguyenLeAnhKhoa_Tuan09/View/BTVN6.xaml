<Window x:Class="_38_NguyenLeAnhKhoa_Tuan09.View.BTVN6"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_38_NguyenLeAnhKhoa_Tuan09.View"
        xmlns:vm="clr-namespace:_38_NguyenLeAnhKhoa_Tuan09.ViewModel"
        mc:Ignorable="d"
        Title="BTVN6" Height="450" Width="800">
    <Window.DataContext>
        <vm:BTVN6_VM/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                <Label Content="Môn học :" Width="100"/>
                <ComboBox ItemsSource="{Binding DS_MonHoc}" DisplayMemberPath="TenMonHoc" SelectedValuePath="MaMonHoc" SelectedValue="{Binding Selected_MonHoc}"/>
            </DockPanel>
            <DockPanel LastChildFill="True" Grid.Column="1" VerticalAlignment="Center">
                <Label Content="Năm học :" Width="100"/>
                <ComboBox ItemsSource="{Binding DS_NamHoc}" SelectedItem="{Binding Selected_NamHoc}"/>
            </DockPanel>
            <DockPanel LastChildFill="True" Grid.Column="2" VerticalAlignment="Center">
                <Label Content="Học kỳ :" Width="100"/>
                <ComboBox ItemsSource="{Binding DS_HocKy}" SelectedItem="{Binding Selected_HocKy}"/>
            </DockPanel>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Content="Tải danh sách sinh viên" Width="130" Height="35" Margin="20,0,20,0" Command="{Binding TaiDanhSachSinhVienCommand}"/>
            <Button Content="Lưu điểm" Width="130" Height="35" Margin="20,0,20,0"/>
        </StackPanel>
        <RadioButton Content="RadioButton" HorizontalAlignment="Left" Margin="1002,162,0,0" Grid.Row="2" VerticalAlignment="Top"/>
        <DataGrid Grid.Row="2" AutoGenerateColumns="False" ItemsSource="{Binding DS_KetQua}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã sinh viên" Width="1*" Binding="{Binding MaSinhVien}"/>
                <DataGridTextColumn Header="Họ tên" Width="2*" Binding="{Binding SinhVien.HoTen}"/>
                <DataGridTextColumn Header="Lớp" Width="2*" Binding="{Binding SinhVien.MaLop}"/>
                <DataGridTextColumn Header="Điểm" Width="2*" Binding="{Binding Diem}"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>
